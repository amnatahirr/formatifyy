# Copy to backend/.env and fill in real values.
# backend/.env is gitignored — never commit secrets.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Gmail SMTP (use an App Password, not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
SMTP_FROM=you@gmail.com

# Platform Super Admin (organizations / multi-tenancy)
SUPER_ADMIN_KEY=super_secret_master_key_here

# JWT for end-user sessions (org_id + user_id + role). Keep secret.
JWT_SECRET=formatify_dev_jwt_secret_change_me

# FYP corpus plagiarism — local check against previous uni reports
# 1) Copy reports → backend/plagiarism/fyp_reports_raw/
# 2) python -m plagiarism.ingest_corpus --rebuild-index
PLAGIARISM_CORPUS_DIR=plagiarism/fyp_corpus
PLAGIARISM_INDEX_DIR=plagiarism/cache
PLAGIARISM_USE_CORPUS=true
PLAGIARISM_ENABLE_WEB=false
PLAGIARISM_LLM_PATTERNS=false
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=
